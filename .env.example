# ---- required -------------------------------------------------------------
# The five builder workers all speak OpenAI Chat Completions.
OPENAI_API_KEY=sk-...

# The Google ADK orchestrator, its QA sub-agent and its art director.
GOOGLE_API_KEY=...

# ---- models ---------------------------------------------------------------
# The two lines that set what the run costs. Defaults are the larger models, for
# the best-looking arcade; the commented values run the whole thing cheaply.
# ORCHESTRATOR_MODEL=gemini-3.5-flash     # cheaper: gemini-3.1-flash-lite
# WORKER_MODEL=gpt-5.5                    # cheaper: gpt-5.4-mini

# ---- bounds ---------------------------------------------------------------
# Every one of these answers "what if this never returns?"
# MAX_ORCHESTRATOR_CALLS=80   # the outer loop's turn budget
# MAX_QA_CALLS=25             # one QA agent judging one game
# WORKER_TIMEOUT_S=300        # a hung worker's whole process tree is killed
# QA_TIMEOUT_S=150            # a wedged browser check is abandoned
# CLOSE_TIMEOUT_S=10          # bounds MCP teardown

# ---- behaviour ------------------------------------------------------------
# QA_HEADLESS=1               # run the QA browser without a window (CI)
# SITE_DIR=./site             # where the arcade is built
